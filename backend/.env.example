# Use PostgreSQL in deployed environments; SQLite is the safe local demo fallback.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional Gemini mode. Without this, GRAMAI uses deterministic Prototype Demo Mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Configure Firebase Admin with one of these, never a tracked serviceAccount.json.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=